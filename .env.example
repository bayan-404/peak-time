# Copy this file to .env.local and fill it in.
# .env.local is gitignored. Never commit real secrets.

# Buffer OAuth app (confidential client)
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Must exactly match the redirect URI registered on your Buffer app (Buffer requires https).
# Local: run "npm run dev:https". Deployed: https://<your-app>.vercel.app/api/auth/callback
# Defaults to <origin>/api/auth/callback if left empty.
BUFFER_REDIRECT_URI=https://localhost:3000/api/auth/callback

# Optional: scopes to request. Default: posts:read posts:write account:read offline_access
BUFFER_SCOPES=

# Encrypts the session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=

# Optional: personal API key, dev fallback only (not used when connected via OAuth)
BUFFER_API_KEY=
